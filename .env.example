# Copy to .env — fake values only. Never put real secrets here.
SECURE_MODE=false

# --- LLM speed ---
# Smaller = faster on weak GPU/CPU. Good defaults:
#   qwen2.5:1.5b-instruct   (fast, good enough for tool JSON)
#   qwen2.5:3b-instruct     (current lab default, slower on CPU)
#   llama3.2:1b             (very fast)
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT_S=120
LIVE_ATTACK_LLM_TIMEOUT_S=60

# Optional Langfuse (self-hosted via ./run.sh up-langfuse)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=pk-lf-fake
LANGFUSE_SECRET_KEY=sk-lf-fake

# Simulated HITL: when SECURE_MODE=true, side-effect tools are denied unless:
LAB_APPROVE=0
