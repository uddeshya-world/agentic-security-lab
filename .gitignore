*.pyc
.venv/
venv/
*.egg-info/
.env
data/chroma/
data/memory.db
data/*.db
metrics/*/results/*.md
metrics/*/results/*.csv
!metrics/*/results/.gitkeep
workspace/*
!workspace/.gitkeep
